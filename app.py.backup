import os
import uuid
import traceback
from flask import Flask, request, render_template_string, send_file, jsonify, redirect, url_for, flash
from werkzeug.utils import secure_filename
from pdf2docx import Converter
from docx2pdf import convert as docx2pdf_convert
from PIL import Image
import tempfile
import shutil

app = Flask(__name__)
app.secret_key = os.urandom(24)
app.config['MAX_CONTENT_LENGTH'] = 50 * 1024 * 1024  # 50 MB limit

# Directories
BASE_DIR = os.path.abspath(os.path.dirname(__file__))
UPLOAD_FOLDER = os.path.join(BASE_DIR, 'uploads')
OUTPUT_FOLDER = os.path.join(BASE_DIR, 'outputs')
ALLOWED_EXTENSIONS = {
    'pdf', 'docx', 'doc', 
    'png', 'jpg', 'jpeg', 'gif', 'bmp', 'tiff', 'webp'
}

os.makedirs(UPLOAD_FOLDER, exist_ok=True)
os.makedirs(OUTPUT_FOLDER, exist_ok=True)

def allowed_file(filename):
    return '.' in filename and \
           filename.rsplit('.', 1)[1].lower() in ALLOWED_EXTENSIONS

def get_file_extension(filename):
    return filename.rsplit('.', 1)[1].lower() if '.' in filename else ''

def convert_pdf_to_docx(input_path, output_path):
    cv = Converter(input_path)
    cv.convert(output_path, start=0, end=None)
    cv.close()

def convert_docx_to_pdf(input_path, output_path):
    # docx2pdf requires libreoffice in PATH
    # We'll ensure the directory containing soffice is in PATH
    docx2pdf_convert(input_path, output_path)

def convert_image(input_path, output_path, format):
    img = Image.open(input_path)
    # Map extension to PIL format
    format_upper = format.upper()
    if format_upper == 'JPG':
        format_upper = 'JPEG'
    # For formats that don't support transparency, convert if necessary
    if format_upper in ['JPEG', 'BMP', 'TIFF']:
        # Convert to RGB if necessary (removes alpha channel)
        if img.mode in ('RGBA', 'LA', 'P'):
            rgb_img = Image.new('RGB', img.size, (255, 255, 255))
            rgb_img.paste(img, mask=img.split()[-1] if img.mode == 'RGBA' else None)
            img = rgb_img
    elif format_upper in ['PNG', 'WEBP', 'GIF']:
        # These support transparency, but we may still want to convert palette modes
        if img.mode == 'P':
            img = img.convert('RGBA')
    img.save(output_path, format=format_upper)
    return output_path

@app.route('/')
def index():
    return render_template_string('''
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <title>Dosya Dönüştürücü</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col items-center py-12">
    <div class="w-full max-w-2xl bg-white rounded-xl shadow-md p-8 space-y-6">
        <h1 class="text-2xl font-bold text-center text-gray-800">Dosya Dönüştürücü</h1>
        <p class="text-center text-gray-600">PDF ↔ Word ve Görüntü formatları arasında dönüştürüm yapın.</p>
        
        <form id="uploadForm" class="space-y-4" enctype="multipart/form-data">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Dosya Seçin</label>
                <input type="file" name="file" id="fileInput" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" required>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Hedef Format</label>
                <select name="target_format" id="targetFormat" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="">Format Seçin</option>
                    <!-- Groups will be populated by JS -->
                </select>
            </div>
            <button type="submit" id="submitBtn" class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed">
                Dönüştür ve İndir
            </button>
        </form>
        
        {% with messages = get_flashed_messages() %}
          {% if messages %}
            <div class="space-y-2">
              {% for message in messages %}
                <div class="p-4 rounded-lg {{ 'bg-red-100 text-red-800' if 'error' in message.lower() else 'bg-green-100 text-green-800' }}">{{ message }}</div>
              {% endfor %}
            </div>
          {% endif %}
        {% endwith %}
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const fileInput = document.getElementById('fileInput');
        const targetFormatSelect = document.getElementById('targetFormat');
        const uploadForm = document.getElementById('uploadForm');
        const submitBtn = document.getElementById('submitBtn');

        const formatGroups = {
          'pdf': ['docx'],
          'docx': ['pdf'],
          'doc': ['pdf'],
          'png': ['jpg', 'jpeg', 'webp', 'bmp', 'tiff', 'gif'],
          'jpg': ['png', 'jpeg', 'webp', 'bmp', 'tiff', 'gif'],
          'jpeg': ['png', 'jpg', 'webp', 'bmp', 'tiff', 'gif'],
          'gif': ['png', 'jpg', 'jpeg', 'webp', 'bmp', 'tiff'],
          'bmp': ['png', 'jpg', 'jpeg', 'webp', 'tiff', 'gif'],
          'tiff': ['png', 'jpg', 'jpeg', 'webp', 'bmp', 'gif'],
          'webp': ['png', 'jpg', 'jpeg', 'bmp', 'tiff', 'gif']
        };

        fileInput.addEventListener('change', function() {
          const file = this.files[0];
          if (!file) {
            targetFormatSelect.innerHTML = '<option value="">Format Seçin</option>';
            targetFormatSelect.disabled = true;
            return;
          }
          const ext = file.name.split('.').pop().toLowerCase();
          const options = formatGroups[ext] || [];
          targetFormatSelect.innerHTML = '<option value="">Format Seçin</option>' + 
            options.map(fmt => `<option value="${fmt}">${fmt.toUpperCase()}</option>`).join('');
          targetFormatSelect.disabled = options.length === 0;
          if (options.length === 0) {
            alert('Bu dosya türü için desteklenen dönüşüm yok.');
          }
        });

        uploadForm.addEventListener('submit', function(e) {
          e.preventDefault();
          if (!fileInput.files[0] || !targetFormatSelect.value) {
            alert('Lütfen dosya seçin ve hedef formatı belirleyin.');
            return;
          }
          submitBtn.disabled = true;
          submitBtn.textContent = 'İşleniyor...';
          const formData = new FormData();
          formData.append('file', fileInput.files[0]);
          formData.append('target_format', targetFormatSelect.value);
          fetch('/convert', {
            method: 'POST',
            body: formData
          })
          .then(response => {
            if (!response.ok) {
              return response.text().then(text => { throw new Error(text); });
            }
            return response.blob();
          })
          .then(blob => {
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = fileInput.files[0].name.split('.').slice(0, -1).join('.') + '.' + targetFormatSelect.value;
            document.body.appendChild(a);
            a.click();
            a.remove();
            window.URL.revokeObjectURL(url);
          })
          .catch(err => {
            alert('Hata: ' + err.message);
          })
          .finally(() => {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Dönüştür ve İndir';
          });
        });
      });
    </script>
  </body>
</html>
    ''')

@app.route('/convert', methods=['POST'])
def convert_file():
    if 'file' not in request.files:
        return jsonify({'error': 'Dosya bulunamadı'}), 400
    file = request.files['file']
    if file.filename == '':
        return jsonify({'error': 'Dosya seçilmedi'}), 400
    target_format = request.form.get('target_format', '').lower().strip()
    if not target_format:
        return jsonify({'error': 'Hedef format belirtilmedi'}), 400

    if not allowed_file(file.filename):
        return jsonify({'error': 'Desteklenmeyen dosya türü'}), 400

    ext = get_file_extension(file.filename)
    if target_format not in ['pdf', 'docx', 'doc', 'png', 'jpg', 'jpeg', 'gif', 'bmp', 'tiff', 'webp']:
        return jsonify({'error': 'Geçersiz hedef format'}), 400

    # Check if conversion is allowed
    allowed_targets = {
        'pdf': ['docx'],
        'docx': ['pdf'],
        'doc': ['pdf'],
        'png': ['jpg', 'jpeg', 'webp', 'bmp', 'tiff', 'gif'],
        'jpg': ['png', 'jpeg', 'webp', 'bmp', 'tiff', 'gif'],
        'jpeg': ['png', 'jpg', 'webp', 'bmp', 'tiff', 'gif'],
        'gif': ['png', 'jpg', 'jpeg', 'webp', 'bmp', 'tiff'],
        'bmp': ['png', 'jpg', 'jpeg', 'webp', 'tiff', 'gif'],
        'tiff': ['png', 'jpg', 'jpeg', 'webp', 'bmp', 'gif'],
        'webp': ['png', 'jpg', 'jpeg', 'bmp', 'tiff', 'gif']
    }
    if ext not in allowed_targets or target_format not in allowed_targets[ext]:
        return jsonify({'error': f'{ext.upper()} dosyasını {target_format.upper()} formato dönüştüremezsiniz.'}), 400

    # Save uploaded file
    filename = secure_filename(file.filename)
    unique_id = uuid.uuid4().hex
    input_path = os.path.join(UPLOAD_FOLDER, f"{unique_id}_{filename}")
    file.save(input_path)

    try:
        # Determine output filename
        base_name = filename.rsplit('.', 1)[0] if '.' in filename else filename
        output_filename = f"{unique_id}_{base_name}.{target_format}"
        output_path = os.path.join(OUTPUT_FOLDER, output_filename)

        # Perform conversion
        if ext == 'pdf' and target_format == 'docx':
            convert_pdf_to_docx(input_path, output_path)
        elif ext in ['docx', 'doc'] and target_format == 'pdf':
            convert_docx_to_pdf(input_path, output_path)
        elif ext in ['png', 'jpg', 'jpeg', 'gif', 'bmp', 'tiff', 'webp'] and target_format in ['png', 'jpg', 'jpeg', 'gif', 'bmp', 'tiff', 'webp']:
            convert_image(input_path, output_path, target_format)
        else:
            return jsonify({'error': 'Desteklenmeyen dönüşüm'}), 400

        # Send file for download
        return send_file(output_path, as_attachment=True, download_name=f"{base_name}.{target_format}")

    except Exception as e:
        print(traceback.format_exc())
        return jsonify({'error': f'Dönüştürme hatası: {str(e)}'}), 500
    finally:
        # Clean up input file (optional)
        try:
            os.remove(input_path)
        except:
            pass

if __name__ == '__main__':
    # Ensure libreoffice is in PATH for docx2pdf
    # We'll add a local bin directory if we have soffice
    libreoffice_path = os.path.join(BASE_DIR, 'libreoffice')
    if os.path.isdir(libreoffice_path):
        # Add to PATH if not already
        os.environ['PATH'] = libreoffice_path + os.pathsep + os.environ.get('PATH', '')
    app.run(host='0.0.0.0', port=int(os.environ.get('PORT', 5000)), debug=False)